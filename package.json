{
  "name": "otonei",
  "version": "1.7.0",
  "private": true,
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11 <12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "firebase": "^12.18.0",
    "localforage": "^1.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-toastify": "^11.1.0",
    "workbox-window": "^7.4.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "eslint src functions --ext .js,.jsx",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:e2e:pwa": "node scripts/run-pwa-e2e.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "lint:ox": "oxlint src functions",
    "lint:ox:check": "oxlint src functions --deny-warnings",
    "format:ox": "oxfmt --write src functions",
    "format:ox:check": "oxfmt --check src functions",
    "verify:release": "pnpm run check:toolchain && pnpm run format:check && pnpm run format:ox:check && pnpm run lint && pnpm run lint:ox:check && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run test:e2e && pnpm run test:e2e:pwa && pnpm audit --prod",
    "prepare": "husky",
    "release": "semantic-release --no-ci"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "*.{json,css,md}": [
      "pnpm exec prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.0",
    "vite": "^8.2.2",
    "vite-plugin-env-compatible": "^2.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1"
  }
}
